{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/update_docs.py\" --quiet >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
